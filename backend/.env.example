APP_NAME=backend
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./app.db
EMBEDDING_DIM=3072

# 아래 네 값은 설정 화면(웹 /settings)에서 재기동 없이 바꿀 수 있다. 한 번 저장하면 DB
# (app_settings)에 남아 여기 적은 값보다 우선하므로, 그 뒤로는 이 파일을 고쳐도 반영되지 않는다.
# 여기 값은 아직 저장한 적이 없을 때 쓰이는 초기값이다.
#
# 임베딩 제공자(Gemini / TEI)와 TEI 주소는 설정 화면에만 있고 이 파일에는 두지 않는다. 여기에
# 필수 항목을 더하면 아직 .env를 고치지 않은 배포가 기동에 실패하기 때문이다.
# EMBEDDING_MODEL은 제공자가 Gemini일 때만 쓰이며, EMBEDDING_DIM 차원을 요청하는 데 쓴다.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
QUERY_REWRITE_MODEL=gemini-3.1-flash-lite
ANSWER_MODEL=gemini-3.1-flash-lite
MIN_COSINE_SIMILARITY=0.5
MIN_FTS_MATCHED_TERMS=1
CHAT_HISTORY_MESSAGES=30
CHAT_HISTORY_MAX_CHARS=8000
DETAIL_MAX_CHARS=20000
